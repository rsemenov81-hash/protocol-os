{
  "name": "protocol-os",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Protocol OS \u2014 single-file PWA, built from src/ by tools/build.mjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "e2e": "node tests/e2e.mjs && node tests/sync-e2e.mjs",
    "ci": "npm run check && npm test && npm run e2e"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.56.1"
  }
}
